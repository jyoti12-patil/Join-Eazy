generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum GroupRole {
  LEADER
  MEMBER
}

enum SubmissionType {
  INDIVIDUAL
  GROUP
}

model User {
  id                 String              @id @default(uuid())
  name               String
  email              String              @unique
  studentId          String?             @unique
  password           String
  role               Role                @default(STUDENT)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  // Relationships
  createdGroups      Group[]             @relation("GroupCreator")
  groupMemberships   GroupMember[]
  createdAssignments Assignment[]        @relation("AssignmentCreator")
  submissions        Submission[]        @relation("SubmittedByUser")
  taughtCourses      Course[]            @relation("CourseProfessor")
  enrollments        CourseEnrollment[]  @relation("EnrolledCourses")

  @@map("users")
}

model Course {
  id          String             @id @default(uuid())
  name        String
  code        String             @unique
  description String?
  professorId String
  professor   User               @relation("CourseProfessor", fields: [professorId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  enrollments CourseEnrollment[]
  assignments Assignment[]

  @@map("courses")
}

model CourseEnrollment {
  id         String   @id @default(uuid())
  courseId   String
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId String
  student   User      @relation("EnrolledCourses", fields: [studentId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@unique([courseId, studentId])
  @@map("course_enrollments")
}

model Group {
  id               String            @id @default(uuid())
  name             String
  code             String            @unique @default(uuid())
  createdById      String
  createdBy        User              @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  maxMembers       Int               @default(5)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  members          GroupMember[]
  assignmentGroups AssignmentGroup[]
  submissions      Submission[]

  @@map("groups")
}

model GroupMember {
  id        String    @id @default(uuid())
  groupId   String
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      GroupRole @default(MEMBER)
  joinedAt  DateTime  @default(now())

  @@unique([groupId, userId])
  @@map("group_members")
}

model Assignment {
  id               String            @id @default(uuid())
  title            String
  description      String
  dueDate          DateTime
  onedriveLink     String
  submissionType   SubmissionType    @default(GROUP)
  createdById      String
  createdBy        User              @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  courseId          String?
  course           Course?           @relation(fields: [courseId], references: [id], onDelete: SetNull)
  isGlobal         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  assignmentGroups AssignmentGroup[]
  submissions      Submission[]

  @@map("assignments")
}

model AssignmentGroup {
  id           String     @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  groupId      String
  group        Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, groupId])
  @@map("assignment_groups")
}

model Submission {
  id                    String     @id @default(uuid())
  assignmentId          String
  assignment            Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  groupId               String?
  group                 Group?     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  submittedById         String
  submittedBy           User       @relation("SubmittedByUser", fields: [submittedById], references: [id], onDelete: Cascade)
  confirmed             Boolean    @default(false)
  submissionNote        String?
  submittedAt           DateTime   @default(now())
  confirmedAt           DateTime?
  acknowledgedByLeader  Boolean    @default(false)
  leaderAcknowledgedAt  DateTime?
  grade                 Float?
  feedback              String?
  gradedAt              DateTime?

  @@unique([assignmentId, groupId])
  @@map("submissions")
}
